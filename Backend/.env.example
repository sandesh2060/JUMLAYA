# ============================================
# JUMLAYA Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=4001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:4001

# ============================================
# DATABASE
# ============================================
# Local MongoDB
DB_CONNECT=mongodb://localhost:27017/jumlaya_db

# MongoDB Atlas (Production)
# DB_CONNECT=mongodb+srv://username:password@cluster.mongodb.net/jumlaya_prod?retryWrites=true&w=majority

# ============================================
# JWT CONFIGURATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# EMAIL CONFIGURATION
# ============================================
# Gmail Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-gmail-app-password

# SendGrid (Alternative)
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=your-sendgrid-api-key

EMAIL_FROM=JUMLAYA <noreply@jumlaya.com>

# ============================================
# ESEWA PAYMENT GATEWAY
# ============================================
ESEWA_ENVIRONMENT=sandbox
# Options: sandbox | production

# Sandbox Credentials
ESEWA_MERCHANT_ID=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# Production Credentials (Replace when going live)
# ESEWA_MERCHANT_ID=your-production-merchant-id
# ESEWA_SECRET_KEY=your-production-secret-key

ESEWA_SUCCESS_URL=http://localhost:5173/payment/success
ESEWA_FAILURE_URL=http://localhost:5173/payment/failure

# ============================================
# KHALTI PAYMENT (Optional)
# ============================================
KHALTI_PUBLIC_KEY=your-khalti-public-key
KHALTI_SECRET_KEY=your-khalti-secret-key

# ============================================
# CLOUDINARY (Image Upload)
# ============================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# FILE UPLOAD
# ============================================
MAX_FILE_SIZE=5242880
# 5MB in bytes

ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,image/jpg
MAX_FILES_PER_UPLOAD=10

# ============================================
# REDIS (Optional - For Caching)
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# SMS GATEWAY (Optional)
# ============================================
SMS_GATEWAY_API_KEY=your-sms-api-key
SMS_GATEWAY_URL=https://sms-gateway.com/api
SMS_SENDER_ID=JUMLAYA

# ============================================
# GOOGLE MAPS (Optional - For Delivery)
# ============================================
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ============================================
# SOCIAL LOGIN (Optional)
# ============================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret

# ============================================
# SECURITY
# ============================================
# Session Secret
SESSION_SECRET=your-session-secret-key

# CORS Origins (comma-separated)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
# 15 minutes in milliseconds

RATE_LIMIT_MAX_REQUESTS=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
# Options: error, warn, info, debug

LOG_FILE_PATH=./logs/app.log

# ============================================
# ANALYTICS (Optional)
# ============================================
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=your-mixpanel-token

# ============================================
# MONITORING (Optional)
# ============================================
SENTRY_DSN=your-sentry-dsn

# ============================================
# CRON JOBS
# ============================================
ENABLE_CRON_JOBS=true
CART_CLEANUP_SCHEDULE="0 2 * * *"
# Daily at 2 AM

ABANDONED_CART_EMAIL_SCHEDULE="0 10 * * *"
# Daily at 10 AM

INVENTORY_SYNC_SCHEDULE="0 */6 * * *"
# Every 6 hours

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_REVIEWS=true
ENABLE_WISHLIST=true
ENABLE_COUPONS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false

# ============================================
# BUSINESS SETTINGS
# ============================================
# Currency
DEFAULT_CURRENCY=NPR

# Tax Rate (13% VAT in Nepal)
TAX_RATE=0.13

# Shipping
FREE_SHIPPING_THRESHOLD=2000
STANDARD_SHIPPING_FEE=100

# Order Settings
ORDER_CANCELLATION_WINDOW_HOURS=24
RETURN_WINDOW_DAYS=7

# Stock Settings
LOW_STOCK_THRESHOLD=10
OUT_OF_STOCK_NOTIFICATION=true

# ============================================
# DEVELOPMENT ONLY
# ============================================
DEBUG=true
VERBOSE_LOGGING=true
MOCK_EMAIL=false
MOCK_SMS=false
MOCK_PAYMENT=false

# ============================================
# NOTES
# ============================================
# 1. Never commit .env file to version control
# 2. Add .env to .gitignore
# 3. Use strong secrets in production
# 4. Rotate keys regularly
# 5. Use environment-specific values
# 6. Keep this file updated with new variables